#define MyAppName "EDT_AESH-v3.15"
#define MyAppVersion "3.1.52"
#define MyAppPublisher "(c) 09/2026 AMOUROUX Bernard"
#define MyAppURL "bernie-tartuffe@gmx.com"
#define MyAppExeName "EDT_AESH-v3.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{DCDCFA76-442A-4F5F-92D4-560DF833A54C}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
;AppVerName={#MyAppName} {#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
DefaultGroupName={#MyAppName}
LicenseFile=C:\Users\bernard\Desktop\Emploi_du_Temps\Licence_gpl-3.0.txt
; Remove the following line to run in administrative install mode (install for all users.)
PrivilegesRequired=lowest
OutputDir=C:\Users\bernard\Desktop\Emploi_du_Temps\build\innosetup
OutputBaseFilename=EDT_AESH_v3.152-setup
SetupIconFile=C:\Users\bernard\Desktop\Emploi_du_Temps\images\EDT.ico
Compression=lzma
SolidCompression=yes
WizardStyle=modern

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
